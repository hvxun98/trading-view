{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/oanda/:env/:path*", "destination": "/api/oanda" },
    { "source": "/api/swissquote/:base/:quote", "destination": "/api/swissquote" }
  ]
}
